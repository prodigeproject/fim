# Environment Variables for Forum Indonesia Muda Website
# Copy this file to .env and fill in the values

# App Configuration
VITE_APP_NAME=Forum Indonesia Muda
VITE_BASE_URL=https://forumindonesiamuda.org

# Social Media
VITE_YOUTUBE_CHANNEL=https://www.youtube.com/ForumIndonesiaMuda
VITE_INSTAGRAM=https://instagram.com/fimnews
VITE_FACEBOOK=https://facebook.com/forumindonesiamuda
VITE_LINKEDIN=https://linkedin.com/company/forum-indonesia-muda

# WordPress REST API (Headless WordPress Integration)
# Uncomment and set the URL when WordPress backend is ready
# Example: https://cms.forumindonesiamuda.org/wp-json/wp/v2
# VITE_WP_API_URL=
